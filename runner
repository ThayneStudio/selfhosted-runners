#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

COMMAND=${1:-help}
shift 2>/dev/null || true

case "$COMMAND" in
    create)    exec "$SCRIPT_DIR/lib/create.sh" "$@" ;;
    destroy)   exec "$SCRIPT_DIR/lib/destroy.sh" "$@" ;;
    start)     exec "$SCRIPT_DIR/lib/start.sh" "$@" ;;
    stop)      exec "$SCRIPT_DIR/lib/stop.sh" "$@" ;;
    list)      exec "$SCRIPT_DIR/lib/list.sh" "$@" ;;
    setup)     exec "$SCRIPT_DIR/lib/setup.sh" "$@" ;;
    add-org)   exec "$SCRIPT_DIR/lib/add-org.sh" "$@" ;;
    remove-org) exec "$SCRIPT_DIR/lib/remove-org.sh" "$@" ;;
    list-orgs) exec "$SCRIPT_DIR/lib/list-orgs.sh" "$@" ;;
    watch)     exec "$SCRIPT_DIR/lib/watch.sh" "$@" ;;
    guard)     exec "$SCRIPT_DIR/lib/guard.sh" "$@" ;;
    gc)        exec "$SCRIPT_DIR/lib/gc.sh" "$@" ;;
    bake)      exec "$SCRIPT_DIR/lib/bake.sh" "$@" ;;
    promote)   exec "$SCRIPT_DIR/lib/promote.sh" "$@" ;;
    maintain)  exec "$SCRIPT_DIR/lib/maintain.sh" "$@" ;;
    drift)     exec "$SCRIPT_DIR/lib/drift.sh" "$@" ;;
    upgrade)   exec "$SCRIPT_DIR/lib/upgrade.sh" "$@" ;;
    help|--help|-h)
        echo "Usage: runner <command> [args]"
        echo ""
        echo "Commands:"
        echo "  setup                       Run the setup wizard"
        echo "  add-org                     Add a GitHub organization"
        echo "  remove-org [<org>]          Remove a GitHub organization"
        echo "  list-orgs                   List configured organizations"
        echo "  create [--org <org>] <name> Create a runner VM manually"
        echo "  destroy <name>              Destroy a managed runner VM"
        echo "  start                       Exit maintenance mode and resume watcher"
        echo "  stop [options]              Enter maintenance mode and stop managed runners"
        echo "  list                        List all runner VMs"
        echo "  watch                       Fill runner pools (run by timer)"
        echo "  guard [--dry-run]           Reap stopped and over-age runner VMs (run by timer)"
        echo "  gc [--dry-run]              Garbage-collect drained template generations"
        echo "  bake [--force] [--dry-run]  Bake a new candidate generation"
        echo "  promote <id> [--skip-canary] Promote a candidate generation to active"
        echo "  maintain                    Unattended adopt/detect/bake cycle (run by timer)"
        echo "  drift                       Report runner version vs the 30-day window (run by timer)"
        echo "  upgrade [--dry-run] [--force] [--foreground]  Bake if needed and promote"
        echo ""
        echo "Runners are ephemeral: one job, shutdown, auto-destroy, watcher recreates."
        ;;
    *)
        echo "Unknown command: $COMMAND" >&2
        echo "Run 'runner help' for usage." >&2
        exit 1
        ;;
esac
