[Unit]
Description=Rebake the GitHub Actions runner template when it is stale
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=REBAKE_FOREGROUND=1
ExecStart=/usr/local/bin/runner rebake
# Default cap: BAKE_TIMEOUT's default of 5400s plus an hour for the image
# download, qm importdisk and qm template, which the poll limit does not
# cover. setup, install and rebake write timeout.conf beside this unit when
# the conf sets another BAKE_TIMEOUT, an hour above that value. A stop still
# SIGTERMs the main process so its trap can destroy a partial VM.
TimeoutStartSec=9000
TimeoutStopSec=180
KillMode=mixed
# qm importdisk is a child of this unit. The watcher's 512M cap kills a healthy import.
SyslogIdentifier=github-runner-rebake
