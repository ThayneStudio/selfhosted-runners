[Unit]
Description=GitHub Actions runner maintain
# pvedaemon must be up before `qm` means anything; a bake talks to the guest.
After=network-online.target pve-cluster.service pvedaemon.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/runner maintain
# One cycle can bake and then canary the image it baked: BAKE_TIMEOUT (90m) +
# CANARY_REGISTER_TIMEOUT (10m) + CANARY_TIMEOUT (30m) = 130m worst case, plus
# the cloud-image download, detect, GC and the drift check. 4h leaves headroom;
# tests/unit/maintain.bats recomputes the sum from the defaults.
TimeoutStartSec=14400
MemoryMax=512M
CPUQuota=200%
SyslogIdentifier=github-runner-maintain
